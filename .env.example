# Copy to .env and fill in. Never commit .env.

# Tiger Data (PostgreSQL + pgvector). Include sslmode=require.
DATABASE_URL=
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional demo/testing default only. Users set the real question in the app (PUT /api/workspace),
# which is stored in the database and always takes precedence. Leave empty to require the user to set it.
RESEARCH_QUESTION=

# Coverage limits — raise only after Checkpoint 2 passes.
MAX_CLAIMS=3
TOP_K=2
SIM_THRESHOLD=0.6

# Bright Data Google Scholar Scraper API (dedicated scraper, not the SERP API).
# Copy the dataset ID and input field from the scraper's page in Bright Data's Scraper Library,
# then save a real sample:  cd backend && .venv/bin/python -m app.discover --sample "ai tutor learning"
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SCHOLAR_DATASET_ID=
BRIGHTDATA_SCHOLAR_INPUT={"keyword": "{query}"}
BRIGHTDATA_LIVE_WAIT_SECONDS=45